<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.10'>
  <model name='starling2max'>
    <pose>0 0 .1 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name='base_link'>
