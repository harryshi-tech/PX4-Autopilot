    <!-- Ground-truth odometry standing in for mocap (OptiTrack): published on
         /model/<model name>/odometry_with_covariance, which gz_bridge forwards
         to PX4 as vehicle_visual_odometry (as in x500_vision) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>
