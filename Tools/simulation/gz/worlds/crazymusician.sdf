<?xml version="1.0"?>
<!--
  CrazyMusician world: PX4's default world (same physics and sensor systems)
  with a sky, soft shadows, a darker matte floor, and a clean GUI for video:
  3D view only, camera tracking, and Gazebo's built-in video recorder.
-->
<sdf version="1.9">
  <world name="crazymusician">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Wind: force on wind-enabled links = mass * k * (wind - link velocity),
         k = 0.3 1/s (keep equal to K_WIND in controllers/adrc/adrc_offboard.py).
         Calm by default; set the wind at run time on /world/crazymusician/wind.
         time_for_rise smooths commanded changes over ~0.5 s. -->
    <plugin name="gz::sim::systems::WindEffects" filename="gz-sim-wind-effects-system">
      <force_approximation_scaling_factor>0.3</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>0.5</time_for_rise>
        </magnitude>
        <direction>
          <time_for_rise>0.5</time_for_rise>
        </direction>
      </horizontal>
      <vertical>
        <time_for_rise>0.5</time_for_rise>
      </vertical>
    </plugin>

    <gui fullscreen="false">
      <!-- 3D view fills the window; no title bars or side panels -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.35 0.35 0.38</ambient_light>
        <background_color>0.75 0.82 0.90</background_color>
        <camera_pose>-2.2 -1.2 1.4 0 0.41 0.50</camera_pose>
        <camera_clip>
          <near>0.05</near>
          <far>500</far>
        </camera_clip>
      </plugin>

      <!-- Required helpers for MinimalScene (invisible) -->
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- Right-click a model > Follow, or scripts/sim.sh follow -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- Play/pause, bottom left -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- Video recorder button, top left. Renders from the 3D view at
           simulation time, so videos play back smoothly at true speed. -->
      <plugin filename="VideoRecorder" name="VideoRecorder">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="z" type="double">1</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <record_video>
          <use_sim_time>true</use_sim_time>
          <lockstep>true</lockstep>
          <bitrate>8000000</bitrate>
        </record_video>
      </plugin>
    </gui>

    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
      <sky></sky>
    </scene>

    <!-- Matte grid floor: low specular avoids glare in videos -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <!-- 1 m grid floor so motion and drift are visible on camera -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://crazymusician_assets/floor.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://crazymusician_assets/grid.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Key light: low-angle sun for readable shadows -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.45 0.35 -0.82</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>
    <!-- Fill light: lifts the dark side of the drone, no shadows -->
    <light name="fill" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.25</intensity>
      <direction>0.5 -0.4 -0.6</direction>
      <diffuse>0.55 0.6 0.7 1</diffuse>
      <specular>0 0 0 1</specular>
    </light>
  </world>
</sdf>
