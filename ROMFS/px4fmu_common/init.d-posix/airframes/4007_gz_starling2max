#!/bin/sh
#
# @name Gazebo starling2max
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=starling2max}

param set-default SIM_GZ_EN 1

# No simulated GPS at all (indoor / mocap setup). EKF2 runs its GPS checks even
# with EKF2_GPS_CTRL 0 and initializes its global origin from the first good fix
# (EKF/gps_checks.cpp, collect_gps); a later set_ekf_origin then reprojects the
# local position from that origin (setEkfGlobalOrigin), shifting the local frame
# away from the vision (Gazebo world) frame.
param set-default SENS_EN_GPSSIM 0
param set-default SENS_EN_BAROSIM 0
param set-default SENS_EN_MAGSIM 1

param set-default BAT_AVRG_CURRENT 3.4
param set-default MPC_THR_HOVER 0.13
param set-default THR_MDL_FAC 0.9
param set-default MPC_THR_MAX 0.60
param set-default MPC_THR_MIN 0.04
param set-default MPC_MANTHR_MIN 0.04
param set-default MC_BAT_SCALE_EN 0
param set-default EKF2_IMU_POS_X 0.005
param set-default EKF2_IMU_POS_Y 0.008
param set-default EKF2_IMU_POS_Z -0.0116
param set-default EKF2_EV_POS_X 0.0
param set-default EKF2_EV_POS_Y 0.0
param set-default EKF2_EV_POS_Z 0.0
param set-default MOT_SLEW_MAX 0.0
param set-default IMU_DGYRO_CUTOFF 40.0
param set-default IMU_ACCEL_CUTOFF 60.0
param set-default IMU_GYRO_CUTOFF 80.0
#param set-default IMU_GYRO_DNF_EN 1
param set-default IMU_GYRO_DNF_HMC 3
param set-default IMU_GYRO_DNF_BW 15
param set-default MC_AIRMODE 0
param set-default MC_ROLLRATE_K 1.0
param set-default MC_PITCHRATE_K 1.0
param set-default MC_YAWRATE_K 1.0
param set-default MC_ROLL_P 8.0
param set-default MC_ROLLRATE_P 0.064
param set-default MC_ROLLRATE_I 0.100
param set-default MC_ROLLRATE_D 0.0013
param set-default MC_PITCH_P 8.0
param set-default MC_PITCHRATE_P 0.064
param set-default MC_PITCHRATE_I 0.096
param set-default MC_PITCHRATE_D 0.0011
param set-default MC_YAW_P 2.8
param set-default MC_YAWRATE_P 0.07
param set-default MC_YAWRATE_I 0.5
param set-default MC_YAWRATE_D 0.0
param set-default MC_ROLLRATE_MAX 20.0
param set-default MC_PITCHRATE_MAX 20.0
param set-default MC_YAWRATE_MAX 150.0
param set-default COM_FAIL_ACT_T 0.000
# Sim only: gz_bridge never sets vehicle_odometry.quality (always 0), so any
# EKF2_EV_QMIN > 0 rejects every vision sample.
param set-default EKF2_EV_QMIN 0
param set-default EKF2_HGT_REF 3
# Vision only, as on hardware indoors (OptiTrack): the model's OdometryPublisher
# stands in for mocap. Simulated GPS would otherwise be fused too and let the
# estimate wander 10-20 cm (EKF2_EV_CTRL keeps its default 15, HGT_REF 3 = vision).
param set-default EKF2_GPS_CTRL 0
# Sim only: heading from vision only (EKF2_EV_CTRL bit 3), as with mocap indoors.
# With the magnetometer fused, its heading disagrees with the vision yaw and
# estimator_status.mag_test_ratio intermittently exceeds COM_ARM_EKF_YAW (0.5):
# "Preflight Fail: Yaw estimate error". The simulated magnetometer stays enabled
# (SENS_EN_MAGSIM 1), so the SYS_HAS_MAG 1 sensor check still passes; the field
# strength check (COM_ARM_MAG_STR 2) is warning-only. Hardware (D0012 params)
# keeps the default EKF2_MAG_TYPE 0.
param set-default EKF2_MAG_TYPE 5
# Sim only: offboard loss -> Hold. The node stops streaming on a safety trip and
# PX4 declares offboard lost after COM_OF_LOSS_T (1 s). The default
# COM_OBL_RC_ACT 0 (Position mode) needs RC; without RC the failsafe framework
# falls back Position -> Altitude -> Stabilized, none of which can run, and ends
# in Return mode (failsafe.cpp checkModeFallback), which climbs to RTL altitude.
# Hold (AUTO_LOITER) needs only local + global position, both available here
# (vision + the EKF origin set by scripts/px4_restart.sh). Hardware keeps the
# default 0: the pilot has RC there.
param set-default COM_OBL_RC_ACT 5
# Sim only: after a node safety trip (it stops streaming setpoints) PX4 should
# take over within 0.2 s instead of flying the stale setpoint for the default 1 s
# (a contact tip-over grew from 25 deg to a crash in that second). The node
# streams at 100 Hz, so 0.2 s is 20 missed setpoints.
param set-default COM_OF_LOSS_T 0.2
# Sim only (on hardware the pilot takes off in Position mode): the keyboard is
# 0.5 m above the floor, so a 1 m takeoff from the 0.368 m pad keeps the song
# entry short and the hover far inside the fence.
param set-default MIS_TAKEOFF_ALT 1.0
param set-default MPC_TKO_RAMP_T 2.00
param set-default COM_SPOOLUP_TIME 2.0
param set-default MPC_TKO_SPEED 1.50
param set-default LNDMC_ROT_MAX 30.0
param set-default LNDMC_TRIG_TIME 0.5
param set-default COM_DISARM_LAND 0.1
param set-default COM_DISARM_PRFLT 20
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.095
param set-default CA_ROTOR0_PY 0.13
param set-default CA_ROTOR1_PX -0.095
param set-default CA_ROTOR1_PY -0.13
param set-default CA_ROTOR2_PX 0.095
param set-default CA_ROTOR2_PY -0.13
param set-default CA_ROTOR3_PX -0.095
param set-default CA_ROTOR3_PY 0.13
param set-default CA_ROTOR0_AX 0.0
param set-default CA_ROTOR0_AY 0.0
param set-default CA_ROTOR1_AX 0.0
param set-default CA_ROTOR1_AY 0.0
param set-default CA_ROTOR2_AX 0.0
param set-default CA_ROTOR2_AY 0.0
param set-default CA_ROTOR3_AX 0.0
param set-default CA_ROTOR3_AY 0.0
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_KM -0.05
param set-default MPC_XY_VEL_MAX 1.00
param set-default MPC_TILTMAX_AIR 20.0

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 209
param set-default SIM_GZ_EC_MIN2 209
param set-default SIM_GZ_EC_MIN3 209
param set-default SIM_GZ_EC_MIN4 209

param set-default SIM_GZ_EC_MAX1 1257
param set-default SIM_GZ_EC_MAX2 1257
param set-default SIM_GZ_EC_MAX3 1257
param set-default SIM_GZ_EC_MAX4 1257
